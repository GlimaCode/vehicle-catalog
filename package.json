{
  "name": "us-make-model-catalog",
  "version": "2.0.0",
  "private": true,
  "description": "Local-first reference application for the standardized US automotive Make/Model/Sub-model catalog (1980 - 2026-07-15)",
  "type": "module",
  "scripts": {
    "install-all": "npm install",
    "db:init": "tsx server/cli.ts db:init",
    "catalog:import": "tsx server/cli.ts catalog:import",
    "catalog:import-if-present": "tsx server/cli.ts catalog:import-if-present",
    "import-catalog": "tsx server/cli.ts catalog:import",
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "dev:server": "tsx server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "export:excel": "tsx server/cli.ts export:excel",
    "export:excel-v2": "tsx server/cli.ts export:excel-v2",
    "export:excel-v3": "tsx server/cli.ts export:excel-v3",
    "export:excel-v4": "tsx server/cli.ts export:excel-v4",
    "export:lookup": "tsx server/cli.ts export:lookup",
    "delta:v2": "tsx server/cli.ts delta:v2",
    "verify:v2": "tsx server/cli.ts verify:v2",
    "db:backup": "tsx server/cli.ts db:backup",
    "db:restore": "tsx server/cli.ts db:restore",
    "verify": "tsx server/cli.ts verify"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "puppeteer-core": "^25.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
