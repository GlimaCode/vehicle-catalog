# Dependencies and build output (regenerated by setup-windows.bat)
node_modules/
web/dist/

# Runtime working files - never commit user data
uploads/*
!uploads/.gitkeep
exports/projects/*
!exports/projects/.gitkeep
backups/*
!backups/.gitkeep

# SQLite sidecars
*.db-wal
*.db-shm

# Temporary and staging artifacts
*.part
*.tmp
*.log
bench/
_v6_stage/
_manifest_extract/
_packaged_db_check/

# OS files
.DS_Store
Thumbs.db

# Secrets - never commit
.env
.env.*

# The Node version pin is optional; uncomment to ignore editor folders
.vscode/
.idea/

# Large generated data — keep out of git (regenerate with npm run catalog:import)
data/*.db
data/*.db-*
exports/*.xlsx
exports/*.csv
!exports/.gitkeep
